---
import { getLocalizedCollection } from '#/utils/collections';
import { useTranslations } from '#/i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as 'es' | 'en';
const t = useTranslations(lang);

const skillEntries = await getLocalizedCollection('skills', lang);
const skills = skillEntries[0]?.data.items || [];
---

<section class="cv-section skills-section">
  <h2 class="section-title">{t('nav.skills')}</h2>
  <div class="skills-grid">
    {skills.map(skill => (
      <div class="skill-item">
        <div class="skill-row"><span class="skill-label">{skill.label1}</span> <span class="skill-value" set:html={skill.value1} /></div>
        <div class="skill-row"><span class="skill-label">{skill.label2}</span> <span class="skill-value">{skill.value2}</span></div>
      </div>
    ))}
  </div>
</section>

<style>
  /* ─── SECTIONS ─── */
  .cv-section {
    padding: 25px 0;
  }
  .cv-section:last-child {
    border-bottom: none;
  }
  .section-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--blue-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 24px;
    padding-bottom: 8px;
    padding-left: 12px;
    border-bottom: 4px solid var(--blue-accent);
    display: block;
    width: 100%;
  }

  .hide-mobile {
    display: inline;
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .hide-mobile {
      display: none !important;
    }
  }

  /* ─── SKILLS ─── */
  .skills-section {
    padding: 0;
    border-bottom: none;
  }

  .skills-title {
    background: var(--bg-section);
    border-top: 1px solid var(--border-main);
    border-bottom: 1px solid var(--border-main);
    padding: 12px 24px;
    color: var(--blue-accent);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: normal;
    margin-bottom: 30px;
    width: 100%;
    display: block;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 30px 20px;
    padding-left: 20px;
  }

  .skill-item {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    transition: none;
  }

  .skill-item:hover {
    background: none;
    border-color: none;
  }

  .skill-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
    font-size: 1rem;
    color: var(--text-main);
  }

  .skill-label {
    font-weight: 700;
    min-width: 100px;
    text-align: left;
    margin-left: 20px;
    color: var(--text-main);
  }

  .skill-value {
    color: var(--text-sub);
  }

  .skill-name {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 6px;
  }
  
  .skill-name strong {
    color: var(--white);
    display: block;
    font-size: 1.1rem;
  }

  .skill-level {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.5);
  }

  .skill-level strong {
    color: var(--blue-bright);
  }

  @media print {
    .hide-mobile {
      display: inline !important;
    }
    .skill-row {
      page-break-after: avoid;
      break-after: avoid;
    }
    .skills-grid {
      display: grid !important;
      grid-template-columns: auto auto auto !important;
      gap: 15px 12px !important;
    }
    .skill-row {
      display: flex !important;
      flex-direction: row !important;
      align-items: baseline !important;
      gap: 4px !important;
      margin-bottom: 8px !important;
      page-break-inside: avoid;
    }
    .skill-label {
      display: inline-block !important;
      min-width: 60px !important;
      flex-shrink: 0 !important;
      font-weight: 600 !important;
    }
  }

  /* ─── RESPONSIVE: TABLET ─── */
  @media (max-width: 768px) {
    .section-title {
      font-size: 1.3rem;
      padding-left: 0;
    }
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
      padding-left: 0;
    }
    .skill-label {
      margin-left: 0;
      min-width: 80px;
      font-size: 0.9rem;
    }
  }

  /* ─── RESPONSIVE: MOBILE ─── */
  @media (max-width: 480px) {
    .section-title {
      text-align: left;
      padding-left: 0;
      margin-bottom: 8px;
      padding-bottom: 5px;
      border-bottom-width: 3px;
    }
    .cv-section {
      padding: 24px 0;
    }
    .skills-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px 12px;
      padding-left: 0;
    }
    .skill-label {
      margin-left: 0;
      min-width: unset;
      font-size: 1.1rem;
    }
    .skill-value {
      font-size: 1rem;
    }
    .skill-row {
      font-size: 1rem;
      margin-bottom: 2px;
      gap: 4px;
      justify-content: flex-start;
    }
    .skill-item {
      text-align: left;
    }
  }
</style>
