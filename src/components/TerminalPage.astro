---
import Layout from '#/layouts/Layout.astro';

import type { ui } from '#/i18n/ui';

import { getLocalizedCollection } from '#/utils/collections';

const lang = (Astro.currentLocale ?? 'es') as keyof typeof ui;
const homeUrl = lang === 'es' ? '/' : '/en/';

const eduEntries = await getLocalizedCollection('education', lang);
const skillsEntries = await getLocalizedCollection('skills', lang);

const certText = eduEntries
  .filter(e => e.data.badgeClass)
  .map(e => {
    const inst = e.data.details.find(d => d.label.includes('Institu'))?.text;
    return inst ? `- ${e.data.title} (${inst})` : `- ${e.data.title}`;
  })
  .join('\n');
const skillsTextLines = skillsEntries[0]?.data.items
  .map(s => {
    const label = s.label1.replace(':', '');
    const val = s.value1.replace(/<[^>]+>/g, '');
    const lvl = s.value2;
    return `[ ${label.padEnd(12, ' ')} ] ${val} (${lvl})`;
  })
  .join('\n') || '';

const skillsText = `[+] SYSTEM SKILLS EXTRACTED:\n======================================================\n${skillsTextLines}\n======================================================`;

const isES = lang === 'es';
const i18nTerminal = {
