    'gobuster': 'Usage:\n  gobuster [command]\n\nAvailable Commands:\n  dir         Uses directory/file enumeration mode\n  dns         Uses DNS subdomain enumeration mode\n  fuzz        Uses fuzzing mode',
    'sqlmap': '        ___\n       __H__\n ___ ___[,]_____ ___ ___  {1.7.2#stable}\n|_ -| . ["]     | .\'| . |\n|___|_  ["]_|_|_|__,|  _|\n      |_|V...       |_|   https://sqlmap.org\n\nUsage: python3 sqlmap.py [options]',
