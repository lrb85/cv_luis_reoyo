---

<Layout title="Terminal - Luis Reoyo">
  <div class="terminal-container">
    <div class="terminal-card fullscreen">
      <div class="terminal-header">
        <span class="term-title" style="text-align: left; padding-left: 10px;">kali@linux:~</span>
        <div class="dots" style="position: absolute; right: 15px; display: flex; gap: 8px;">
          <span class="dot" style="background:#555; display:flex; align-items:center; justify-content:center; color:#ccc; font-size:10px; font-weight:bold;">_</span>
          <span class="dot" style="background:#555; display:flex; align-items:center; justify-content:center; color:#ccc; font-size:10px; font-weight:bold;">□</span>
          <a href={homeUrl} class="dot dot-red" id="close-term" style="background:#cc0000; text-decoration:none; display:flex; align-items:center; justify-content:center; color:#fff; font-size:10px; font-weight:bold; line-height:1;">&times;</a>
        </div>
      </div>
      <div class="terminal-body" id="term-body">
        <p class="output desc">{i18nTerminal.welcome}</p>
        <p class="output desc">{i18nTerminal.helpText}</p>
        <br/>
        <div id="term-output"></div>
        <form id="term-form" class="cmd" style="display: flex; gap: 8px;">
          <span class="prompt">kali@linux:~$</span>
          <input type="text" id="term-input" autocomplete="off" spellcheck="false" style="background: transparent; border: none; color: inherit; font-family: inherit; font-size: inherit; outline: none; width: 100%;" autofocus />
        </form>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ i18nTerminal, homeUrl }}>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('term-form');
      const input = document.getElementById('term-input');
      const output = document.getElementById('term-output');
      const body = document.getElementById('term-body');
      // El botón close-term ya navega usando su atributo href
      
      if (!form || !input || !output) return;
      if (form.dataset.loaded) return;
      form.dataset.loaded = 'true';

      const cmds = Object.keys(i18nTerminal.commands).filter(c => c !== '?');
      const files = ['certifications.txt', 'skills.md', 'cv.pdf'];

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          const val = input.value;
          const lowerVal = val.toLowerCase();
          
          if (lowerVal.startsWith('cat ')) {
            const arg = lowerVal.substring(4);
            const match = files.find(f => f.startsWith(arg));
            if (match) input.value = val.substring(0, 4) + match;
          } else if (lowerVal.startsWith('ls ')) {
            const arg = lowerVal.substring(3);
            const match = files.find(f => f.startsWith(arg));
            if (match) input.value = val.substring(0, 3) + match;
          } else {
            const match = cmds.find(c => c.startsWith(lowerVal));
            if (match) input.value = match;
          }
        }
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const val = input.value.trim();
        const lowerValFull = val.toLowerCase();
        const lowerVal = lowerValFull.split(' ')[0]; // base command
        if (!val) return;

        const cmdLine = document.createElement('p');
        cmdLine.className = 'cmd';
        cmdLine.innerHTML = `<span class="prompt">kali@linux:~$</span> ${val}`;
        output.appendChild(cmdLine);

        const resLine = document.createElement('div');
        resLine.className = 'output desc';
        
        if (lowerVal === 'clear') {
          output.innerHTML = '';
          input.value = '';
          return;
        }
        
        if (lowerVal === 'exit') {
          window.location.href = homeUrl;
          return;
        }

        if (lowerVal === 'echo') {
          resLine.innerText = val.substring(4).trim();
          output.appendChild(resLine);
          input.value = '';
          if(body) body.scrollTop = body.scrollHeight;
          return;
        }

        if (lowerVal === 'cat') {
          const arg = val.substring(4).trim();
          if (!arg) {
            resLine.innerText = 'cat: missing operand';
          } else if (arg === 'certifications.txt') {
            resLine.innerText = i18nTerminal.certText;
          } else if (arg === 'skills.md') {
            resLine.innerText = i18nTerminal.skillsText;
          } else if (arg === 'cv.pdf') {
            resLine.innerText = 'Error: Cannot display binary file. Use download_cv instead.';
          } else {
            resLine.innerText = `cat: ${arg}: No such file or directory`;
          }
          output.appendChild(resLine);
          input.value = '';
          if(body) body.scrollTop = body.scrollHeight;
          return;
        }
        
        if (lowerVal === 'date') {
          resLine.innerText = new Date().toString();
          output.appendChild(resLine);
          input.value = '';
          if(body) body.scrollTop = body.scrollHeight;
          return;
        }

        if (i18nTerminal.commands[lowerValFull]) {
          resLine.innerText = i18nTerminal.commands[lowerValFull];
          if (lowerValFull === 'download_cv') {
            setTimeout(() => { window.location.href = '/?print=true'; }, 1000);
          }
        } else if (i18nTerminal.commands[lowerVal]) {
          resLine.innerText = i18nTerminal.commands[lowerVal];
          if (lowerVal === 'download_cv') {
            setTimeout(() => { window.location.href = '/?print=true'; }, 1000);
          }
        } else {
          resLine.innerText = i18nTerminal.notFound.replace('{cmd}', lowerVal);
        }
        
        output.appendChild(resLine);
        input.value = '';
        if(body) body.scrollTop = body.scrollHeight;
      });
      
      // Auto-focus on click
      document.querySelector('.terminal-card')?.addEventListener('click', () => {
        input.focus();
      });
    });
  </script>
</Layout>

<style>
  :root {
    --term-red: #ff5f56;
    --term-yellow: #ffbd2e;
    --term-green: #27c93f;
    --term-bg-dark: rgba(10, 15, 25, 0.95);
    --term-bg-light: rgba(240, 240, 240, 0.95);
  }

  .terminal-container {
    height: calc(100vh - 80px);
    display: flex;
    padding: 1rem;
    font-family: 'Source Sans 3', sans-serif;
  }

  .terminal-card.fullscreen {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #111111;
    border: 1px solid #333;
    border-radius: 6px 6px 0 0;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
  }

  .terminal-header {
    background: #2d2d2d;
    padding: 8px 15px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #1a1a1a;
    position: relative;
  }
  
  .dots {
    display: flex;
    gap: 8px;
    position: absolute;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.2s;
  }
  
  .dot:hover {
    transform: scale(1.2);
  }

  .dot-red { background: var(--term-red); }
  .dot-yellow { background: var(--term-yellow); }
  .dot-green { background: var(--term-green); }

  .term-title {
    flex: 1;
    text-align: center;
    font-family: monospace;
    font-size: 0.95rem;
    color: #dfdfdf;
  }
  
  :root[data-theme="light"] .term-title {
    color: #333;
  }

  .terminal-body {
    padding: 25px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 1.1rem;
    flex: 1;
    overflow-y: auto;
    color: #f1f1f1;
  }

  :root[data-theme="light"] .terminal-body {
    color: #222;
  }

  .cmd {
    margin-bottom: 12px;
  }

  .prompt {
    color: #268bd2;
    font-weight: 600;
  }
  
  .output {
    margin-bottom: 15px;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .output.desc {
    color: #cccccc;
  }
  
  :root[data-theme="light"] .output.desc {
    color: #555;
  }

  :root[data-theme="light"] .terminal-card.fullscreen {
    background: #f7f7f7;
    border: 1px solid #ccc;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  :root[data-theme="light"] .terminal-header {
    background: #e2e2e2;
    border-bottom: 1px solid #d0d0d0;
  }

  :root[data-theme="light"] .dot {
    background: #aaa !important;
    color: #fff !important;
  }
  
  :root[data-theme="light"] .dot.dot-red {
    background: #cc0000 !important;
  }
</style>
