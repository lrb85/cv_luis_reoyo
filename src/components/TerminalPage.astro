    'help': isES ? 'Comandos: whoami, skills, clear, exit, sudo, download_cv, date, echo, ping, ls, cat, ifconfig, nmap, netstat, traceroute, tcpdump, nc, route, ip, ssh, gobuster, sqlmap, john, hashcat, msfconsole, hydra, scapy, wfuzz, nikto, dirb, linpeas, iptables, nft, ufw, fail2ban-client, apparmor_status, lynis' : 'Commands: whoami, skills, clear, exit, sudo, download_cv, date, echo, ping, ls, cat, ifconfig, nmap, netstat, traceroute, tcpdump, nc, route, ip, ssh, gobuster, sqlmap, john, hashcat, msfconsole, hydra, scapy, wfuzz, nikto, dirb, linpeas, iptables, nft, ufw, fail2ban-client, apparmor_status, lynis',
    'whoami': isES ? 'Eres un reclutador o un desarrollador muy curioso. ¡Bienvenido!' : 'You are a recruiter or a very curious developer. Welcome!',
    'skills': skillsText || (isES ? 'No hay habilidades' : 'No skills found'),
    'clear': 'CLEAR_CMD',
    'exit': 'EXIT_CMD',
    'sudo': isES ? 'kali no está en el archivo sudoers. Este incidente será reportado a Luis.' : 'kali is not in the sudoers file. This incident will be reported to Luis.',
    'download_cv': isES ? 'Iniciando descarga del CV...' : 'Initializing CV download...',
    'ping': 'PONG!',
    'date': '',
    'echo': '',
    'ls': 'certifications.txt  skills.md  cv.pdf',
    'cat': '',
    'ifconfig': 'eth0: flags=4163<UP,BROADCAST,RUNNING,MULTICAST>  mtu 1500\n        inet 192.168.1.104  netmask 255.255.255.0  broadcast 192.168.1.255\n        inet6 fe80::a00:27ff:fe4e:66a  prefixlen 64  scopeid 0x20<link>\n        ether 08:00:27:4e:06:6a  txqueuelen 1000  (Ethernet)',
