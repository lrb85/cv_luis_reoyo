---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: "website" | "article" | "profile";
}

const {
  title,
  description = (Astro.currentLocale ?? 'es') === 'es' ? "Currículum Vitae de Luis Reoyo - Senior en Seguridad de Redes." : "Luis Reoyo's Resume - Senior in Network Security.",
  image = `/og-${Astro.currentLocale ?? 'es'}.png`,
  canonicalURL = new URL(Astro.url.pathname, "https://curriculum.genkipool.com"),
  type = "website",
} = Astro.props;

const lang = Astro.currentLocale ?? 'es';
const siteName = "CV Luis Reoyo";
const twitterHandle = "@GenkipoolC";
const defaultThemeColor = "#1e2d3d";

const canonicalStr = typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.toString();
const baseUrl = "https://curriculum.genkipool.com";
const fullImageUrl = new URL(image, baseUrl).toString();
const jobTitle = lang === 'es' ? "Senior en Seguridad de Redes" : "Senior in Network Security";

import { getLocalizedCollection } from '#/utils/collections';

const eduEntries = await getLocalizedCollection('education', lang);
const skillsEntries = await getLocalizedCollection('skills', lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Luis Reoyo",
  "url": baseUrl,
  "image": fullImageUrl,
  "jobTitle": jobTitle,
  "description": description,
  "sameAs": [
    "https://github.com/genkipool",
    "https://x.com/GenkipoolC"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Madrid",
    "addressCountry": "ES"
  },
  "knowsAbout": skillsEntries[0]?.data.items.map(s => s.value1.replace(/<[^>]+>/g, '')).filter(Boolean) || [],
  "alumniOf": eduEntries.filter(e => e.data.id === 'master' || e.data.id === 'degree').map(e => ({
    "@type": "EducationalOrganization",
    "name": e.data.details.find(d => d.label.includes('Centro') || d.label.includes('Center'))?.text || "Unknown"
  })),
  "worksFor": {
    "@type": "Organization",
    "name": "Genkipool"
  },
  "hasCredential": eduEntries.filter(e => e.data.badgeClass.includes('ccnp') || e.data.badgeClass.includes('ceh')).map(e => {
    const org = e.data.details.find(d => d.label.includes('Institu'))?.text || "Unknown";
    const verif = e.data.details.find(d => d.label.includes('Verif'))?.url;
    return {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "certification",
      "name": e.data.title,
      "recognizedBy": {
        "@type": "Organization",
        "name": org
      },
      ...(verif ? { url: verif } : {})
    };
  })
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={defaultThemeColor} />

<!-- Favicons & Manifest -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalStr} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalStr} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Luis Alberto Reoyo Bolaños - CV Header" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'es' ? "es_ES" : "en_US"} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalStr} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:site" content={twitterHandle} />

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
