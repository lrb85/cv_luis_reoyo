---
import { useTranslations } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title="Luis Alberto Reoyo Bolaños - Security Technician" lang={lang}>

  <!-- HEADER -->
  <header class="cv-header">
    <div class="container">
      <!-- TOP CONTROLS -->
      <div class="top-controls">
        <button id="download-pdf" class="theme-btn pdf-btn" aria-label="Download PDF">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        </button>

        <div class="lang-switcher">
          <a href={import.meta.env.BASE_URL.replace(/\/$/, '') || '/'} class={lang === 'es' ? 'active' : ''}>ES</a>
          <span class="separator">|</span>
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/en`} class={lang === 'en' ? 'active' : ''}>EN</a>
        </div>

        <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sun-icon"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M22 12h2"/><path d="m4.93 19.07 1.41-1.41"/><path d="m17.66 6.34 1.41-1.41"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="moon-icon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </div>
      
      <div class="header-inner">
        <div class="header-text">
          <h1 class="name">Luis Alberto Reoyo Bolaños</h1>
          <p class="job-title">{t('header.job')}</p>
          <p class="summary">
            {t('header.summary')}
          </p>
          <div class="contact-bar">
            <a href="mailto:luisrb1985@gmail.com" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              luisrb1985@gmail.com
            </a>
            <a href="tel:617238725" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
              617-23-87-25
            </a>
            <a href="https://github.com/genkipool" target="_blank" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              github.com/genkipool
            </a>
            <div class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Madrid, España
            </div>
          </div>
        </div>
        <div class="header-avatar">
          <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/luis_reoyo.png`} alt="Luis Alberto Reoyo Bolaños" />
        </div>
      </div>
    </div>
  </header>

  <main class="cv-body">
    <div class="container">
      <!-- EXPERIENCIA PROFESIONAL -->
      <section class="cv-section">
        <h2 class="section-title">{t('nav.experience')}</h2>

        <!-- EXP: Blockchain -->
        <div class="exp-item">
          <div class="exp-label">
            <span class="category-label">{t('label.category')}</span>
            <strong>{t('exp.blockchain.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.project')}</span>
              {t('exp.blockchain.company')}
              <span class="date-range">(2021 - {t('label.currently')}).</span>
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.function')}</span>
              <span set:html={t('exp.blockchain.f1')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.blockchain.f2')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.blockchain.f3')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.blockchain.f4')} />
            </div>
          </div>
        </div>

        <!-- EXP: Tutor -->
        <div class="exp-item">
          <div class="exp-label">
            <span class="category-label">{t('label.category')}</span>
            <strong>{t('exp.tutor.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.company')}</span>
              {t('exp.tutor.company')}
              <span class="date-range">(2019 - 2022).</span>
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.function')}</span>
              <span set:html={t('exp.tutor.f1')} />
            </div>
          </div>
        </div>

        <!-- EXP: Auditor -->
        <div class="exp-item">
          <div class="exp-label">
            <span class="category-label">{t('label.category')}</span>
            <strong>{t('exp.auditor.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.company')}</span>
              Capgemini Engineering (antiguamente Altran Tecnologies)
              <span class="date-range">(2017 - {t('label.currently')}).</span>
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.function')}</span>
              <span set:html={t('exp.auditor.f1')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.auditor.f2')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.auditor.f3')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.auditor.f4')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.auditor.f5')} />
            </div>
          </div>
        </div>

        <!-- EXP: Hardening -->
        <div class="exp-item" id="print-break">
          <div class="exp-label">
            <span class="category-label">{t('label.category')}</span>
            <strong>{t('exp.hardening.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.company')}</span>
              Capgemini Engineering (antiguamente Altran Tecnologies)
              <span class="date-range">(2014 - {t('label.currently')}).</span>
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.function')}</span>
              <span set:html={t('exp.hardening.f1')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.hardening.f2')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.hardening.f3')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.hardening.f4')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('exp.hardening.f5')} />
            </div>
          </div>
        </div>
      </section>

      <!-- PROYECTOS PERSONALES -->
      <section class="cv-section">
        <h2 class="section-title">{t('nav.projects')}</h2>

        <!-- PROJECT: Intelligent Workspace -->
        <div class="exp-item">
          <div class="exp-label">
            <span class="category-label">{t('label.project')}</span>
            <strong>{t('proj.navigator.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.status')}</span>
              {t('proj.navigator.status')}
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.description')}</span>
              <span set:html={t('proj.navigator.desc')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.navigator.f1')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.navigator.f2')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.navigator.f3')} />
            </div>
          </div>
        </div>

        <!-- PROJECT: Radix DLT Community -->
        <div class="exp-item">
          <div class="exp-label">
            <span class="category-label">{t('label.collaboration')}</span>
            <strong>{t('proj.radix.title')}</strong>
          </div>
          <div class="exp-details">
            <div class="exp-company">
              <span class="detail-label">{t('label.web')}</span>
              <a href="https://radix-community.genkipool.com/es" target="_blank" class="project-link">radix-community.genkipool.com</a>
            </div>
            <div class="exp-company">
              <span class="detail-label">{t('label.github')}</span>
              <a href="https://github.com/genkipool/Radix_Community" target="_blank" class="project-link">github.com/genkipool/Radix_Community</a>
            </div>
            <div class="exp-func">
              <span class="detail-label">{t('label.description')}</span>
              <span set:html={t('proj.radix.desc')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.radix.f1')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.radix.f2')} />
            </div>
            <div class="exp-func extra">
              <span class="detail-label">&nbsp;</span>
              <span set:html={t('proj.radix.f3')} />
            </div>
          </div>
        </div>
      </section>

      <!-- FORMACIÓN ACADÉMICA -->
      <section class="cv-section" id="education-section">
        <h2 class="section-title">{t('nav.education')}</h2>
        <div class="edu-grid">

          <!-- Especialista en seguridad informática e información -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>{t('edu.master.title')}</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.course')}</span> {t('edu.master.course')}</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> {t('edu.master.center')}</div>
              </div>
            </div>
            <div class="edu-badge seg">SEG</div>
          </div>

          <!-- CCNP Security -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>CCNP Security (Cisco Certified Network Professional Security).</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.institution')}</span> Cisco Systems Inc.</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> CBCenter Training SL.</div>
                <div class="edu-row"><span class="detail-label">{lang === 'es' ? 'Verificación:' : 'Verification:'}</span> <a href="https://cp.certmetrics.com/cisco/en/public/verify/credential/VHYXZZFL7DREQT33" target="_blank" rel="noopener noreferrer" class="project-link">VHYXZZFL7DREQT33</a></div>
              </div>
            </div>
            <div class="edu-badge ccnp">CCNP</div>
          </div>

          <!-- CCNP -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>CCNP (Cisco Certified Network Professional).</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.institution')}</span> Cisco Systems Inc.</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> CBCenter Training SL.</div>
                <div class="edu-row"><span class="detail-label">{lang === 'es' ? 'Verificación:' : 'Verification:'}</span> <a href="https://cp.certmetrics.com/cisco/en/public/verify/credential/K1F43XVF1LQQ109Y" target="_blank" rel="noopener noreferrer" class="project-link">K1F43XVF1LQQ109Y</a></div>
              </div>
            </div>
            <div class="edu-badge ccnp2">CCNP</div>
          </div>

          <!-- CEH -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>CEH - Certified Ethical Hacker (312-50 v10).</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.institution')}</span> EC-Council Certified Ethical Hacker.</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> EC-Council Exam Center.</div>
              </div>
            </div>
            <div class="edu-badge ceh">CEH</div>
          </div>

          <div class="edu-spacer" style="height: 20px;"></div>

          <!-- PHP Hacking -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>{t('edu.php.title')}</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.course')}</span> {t('edu.php.course')}</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> The Security Sentinel.</div>
              </div>
            </div>
            <div class="edu-badge cpphp">CPPHP</div>
          </div>

          <!-- Hacking Ético -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>{t('edu.hack.title')}</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.course')}</span> {t('edu.hack.title')}</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> Securizame.</div>
              </div>
            </div>
            <div class="edu-badge hack">HACK</div>
          </div>

          <!-- Técnico superior -->
          <div class="edu-item">
            <div class="edu-info">
              <div class="edu-label-main">
                <span class="category-label">{t('label.degree')}</span>
                <strong>{t('edu.degree.title')}</strong>
              </div>
              <div class="edu-details">
                <div class="edu-row"><span class="detail-label">{t('label.course')}</span> {t('edu.degree.course')}</div>
                <div class="edu-row"><span class="detail-label">{t('label.center')}</span> I.E.S Juan de la Cierva.</div>
              </div>
            </div>
            <div class="edu-badge dpe">DPE</div>
          </div>

        </div>
      </section>

      <!-- SKILLS -->
      <section class="cv-section skills-section">
        <h2 class="section-title">{t('nav.skills')}</h2>
        <div class="skills-grid">
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.language')}</span> <span class="skill-value">Python & PHP.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.lang.level')}.</span></div>
          </div>
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.system')}</span> <span class="skill-value">Linux.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.lang.level')}.</span></div>
          </div>
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.networking')}</span> <span class="skill-value">Cisco & Juniper.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.lang.level')}.</span></div>
          </div>
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.language')}</span> <span class="skill-value">{lang === 'es' ? 'Inglés' : 'English'}.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.eng.level')}.</span></div>
          </div>
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.carnet')}</span> <span class="skill-value">{lang === 'es' ? 'Conducir' : 'Driving'}.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.driving.level')}.</span></div>
          </div>
          <div class="skill-item">
            <div class="skill-row"><span class="skill-label">{t('label.tools')}</span> <span class="skill-value"><span class="hide-mobile">Metasploit, </span>Nmap<span class="hide-mobile">, Scapy, GNS3</span>.</span></div>
            <div class="skill-row"><span class="skill-label">{t('label.level')}</span> <span class="skill-value">{t('skill.lang.level')}.</span></div>
          </div>
        </div>
      </section>
    </div>
  </main>

</Layout>

<style>
  /* ─── RESPONSIVE: TABLET ─── */
  @media (max-width: 768px) {
    .top-controls {
      right: 16px;
    }
    .edu-item {
      gap: 16px;
    }
    .edu-details {
      padding-left: 10px;
    }
    .edu-label-main {
      flex-direction: column;
      gap: 4px;
    }
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }
    .skill-label {
      margin-left: 0;
      min-width: unset;
      font-size: 0.9rem;
    }
  }

  /* ─── RESPONSIVE: MOBILE ─── */
  @media (max-width: 480px) {
    /* Skills: 2 columns compact */
    .skills-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px 10px;
    }
    .skill-item {
      text-align: left;
    }
    .skill-row {
      justify-content: flex-start;
    }
    .hide-mobile {
      display: none;
    }
    /* Experience: unified with education flat style */
    .exp-label {
      flex-direction: row;
      align-items: baseline;
      gap: 0;
    }
    .exp-details {
      padding-left: 8px;
      border-left: 2px solid var(--blue-accent);
    }
    .category-label {
      display: none;
    }
    .detail-label {
      display: none;
    }
    /* Education: compact horizontal */
    .edu-item {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 10px;
    }
    .edu-details {
      padding-left: 8px;
      border-left-width: 2px;
    }
    .edu-label-main {
      flex-direction: column;
      gap: 1px;
    }
  }
</style>
