---
interface Props {
  title: string;
}
import { ClientRouter } from 'astro:transitions';
import { useTranslations } from '#/i18n/utils';
import SEO from '../components/SEO.astro';

const { title } = Astro.props;
const lang = (Astro.currentLocale ?? 'es') as keyof typeof import('#/i18n/ui').ui;
const t = useTranslations(lang);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <SEO title={title} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <ClientRouter />
  <script defer src="https://cloud.umami.is/script.js" data-website-id="d892b021-e903-4040-b41d-768fde8cce54"></script>
  <script is:inline>
    const setTheme = () => {
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);

    };
    setTheme();
    document.addEventListener('astro:after-swap', setTheme);
  </script>
</head>
<body>
  <slot />
  <footer class="cv-footer">
    <div class="container">
      <div class="footer-content">
        <span class="footer-line"></span>
        <p>{t('footer.copy')}</p>
        <span class="footer-line"></span>
      </div>
    </div>
  </footer>
  <script>
    const handleToggle = () => {
      const element = document.documentElement;
      const isDark = element.getAttribute('data-theme') === 'dark';
      const nextTheme = isDark ? 'light' : 'dark';
      element.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
      
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        const upcomingTheme = nextTheme === 'light' ? 'dark' : 'light';
        themeBtn.title = upcomingTheme === 'light' ? themeBtn.getAttribute('data-title-light') : themeBtn.getAttribute('data-title-dark');
      }
    };

    document.addEventListener('astro:page-load', () => {


      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', handleToggle);
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const upcomingTheme = currentTheme === 'light' ? 'dark' : 'light';
        themeBtn.title = upcomingTheme === 'light' ? themeBtn.getAttribute('data-title-light') : themeBtn.getAttribute('data-title-dark');
      }



      const copyMdBtn = document.getElementById('copy-markdown');
      if (copyMdBtn) {
        copyMdBtn.addEventListener('click', async () => {
          try {
            const lang = document.documentElement.lang || 'es';
            const endpoint = lang === 'en' ? '/en/cv.md' : '/cv.md';
            const res = await fetch(endpoint);
            if (!res.ok) throw new Error('Failed to fetch Markdown');
            const md = await res.text();
            await navigator.clipboard.writeText(md);
            // Flash some UI change if needed, or just change icon temporarily
            const originalHTML = copyMdBtn.innerHTML;
            copyMdBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            setTimeout(() => {
              copyMdBtn.innerHTML = originalHTML;
            }, 2000);
          } catch (err) {
            console.error('Error copying markdown:', err);
          }
        });
      }
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --navy: #1e2d3d;
    --navy-mid: #253545;
    --navy-light: #2e4057;
    --blue-accent: #4a9ecf; 
    --blue-bright: #5db8e8;
    --text-dark: #0f172a;
    --text-mid: #334155;
    --text-light: #475569;
    --white: #ffffff;
    --off-white: #f9fafb;
    --border: #cbd5e1;
    --section-bg: #f1f5f9;

    /* Theme-able variables */
    --bg-main: var(--white);
    --bg-card: var(--white);
    --bg-section: var(--section-bg);
    --text-main: var(--text-dark);
    --text-sub: var(--text-mid);
    --border-main: var(--border);
    --header-grad: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
  }

  :root[data-theme="dark"] {
    --bg-main: #0f172a;
    --bg-card: #1e293b;
    --bg-section: #020617;
    --text-main: #f8fafc;
    --text-sub: #94a3b8;
    --border-main: #334155;
    --header-grad: linear-gradient(135deg, #020617 0%, #1e293b 100%);
    --blue-accent: #60a5fa;
  }

  html, body {
    font-family: 'Source Sans 3', sans-serif;
    background: var(--bg-main);
    color: var(--text-main);
    font-size: 16px;
    line-height: 1.6;
    transition: background-color 0.3s, color 0.3s;
  }

  .cv-footer {
    margin-top: 100px;
    padding: 50px 0;
    background: var(--header-grad);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  .cv-footer::before {
    content: '';
    position: absolute;
    top: -30px;
    left: -30px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(74, 158, 207, 0.1);
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    color: var(--white);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .footer-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
    max-width: 100px;
  }

  @media print {
    .cv-footer {
      display: none !important;
    }
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 25px;
  }

  .cv-wrapper {
    min-height: 100vh;
  }

  /* ─── BODY ─── */
  .cv-body {
    padding: 0 0 25px;
  }

  /* ─── GLOBAL THEME BTNS & TOP CONTROLS ─── */
  .top-controls {
    position: absolute;
    top: 20px;
    right: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10;
  }

  .theme-btn {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
    border: none;
    color: white;
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }

  .top-actions {
    display: flex;
    gap: 8px;
  }

  .theme-btn:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.1);
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :root[data-theme="dark"] .sun-icon { display: block; }
  :root[data-theme="dark"] .moon-icon { display: none; }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
    padding: 6px 14px;
    border-radius: 20px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
  }
  .lang-switcher a {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: all 0.2s;
  }
  .lang-switcher a:hover, .lang-switcher a.active {
    color: white;
  }
  .lang-switcher .separator {
    color: rgba(255,255,255,0.3);
  }

  @media print {
    :root, :root[data-theme="dark"] {
      --bg-main: var(--white) !important;
      --bg-card: var(--white) !important;
      --bg-section: var(--section-bg) !important;
      --text-main: var(--text-dark) !important;
      --text-sub: var(--text-mid) !important;
      --border-main: var(--border) !important;
      --header-grad: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%) !important;
      --blue-accent: #4a9ecf !important;
    }
    @page { margin: 10mm 0; }
    @page :first { margin-top: 0; }
    html { font-size: 12px !important; }
    body {
      background: white !important;
      color: black !important;
      -webkit-print-color-adjust: exact;
      color-adjust: exact;
    }
    .top-controls, .theme-btn, .lang-switcher { display: none !important; }
    .container {
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 15mm !important;
    }
    .cv-body { padding: 0 !important; }
    .cv-section { padding-top: 5mm !important; padding-bottom: 5mm !important; }
    .section-title {
      page-break-after: avoid;
      break-after: avoid;
    }
  }

  /* ─── RESPONSIVE: TABLET ─── */
  @media (max-width: 768px) {
    .container { padding: 0 20px; }
    .top-controls {
      top: 10px;
      right: 10px;
      gap: 8px;
    }
    .lang-switcher {
      padding: 4px 10px;
      font-size: 0.85rem;
    }
    .theme-btn {
      padding: 8px;
      min-width: 36px;
      min-height: 36px;
    }
  }

  /* ─── RESPONSIVE: MOBILE ─── */
  @media (max-width: 480px) {
    html, body {
      overflow-x: hidden;
      max-width: 100vw;
    }
    .container {
      padding: 0 25px;
      max-width: 100%;
      overflow-wrap: break-word;
      word-break: break-word;
    }
    .top-controls {
      top: 5px;
      right: 5px;
      gap: 4px;
    }
    .theme-btn {
      padding: 5px;
      min-width: 32px;
      min-height: 32px;
    }
    .theme-btn svg {
      width: 15px;
      height: 15px;
    }
    .lang-switcher {
      padding: 3px 8px;
    }
    .cv-body {
      padding: 0 0 14px;
    }
  }
</style>